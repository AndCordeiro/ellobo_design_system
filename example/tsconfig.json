{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@ellobo/design-system": ["../src/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native"],
      "styled-components": ["./node_modules/styled-components"],
      "styled-components/native": ["./node_modules/styled-components/native"],
      "react-native-svg": ["./node_modules/react-native-svg"],
      "react-native-safe-area-context": ["./node_modules/react-native-safe-area-context"]
    }
  },
  "include": ["index.js", "src/**/*.ts", "src/**/*.tsx", "../src/**/*.ts", "../src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "dist",
    "../src/**/*.test.ts",
    "../src/**/*.test.tsx",
    "../src/test-utils"
  ]
}
