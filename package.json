{
  "name": "@ellobo/design-system",
  "version": "0.1.0",
  "description": "El Lobo Design System — themeable, accessible React Native component library shared across El Lobo Labs apps.",
  "license": "MIT",
  "author": "André Cordeiro (https://github.com/AndCordeiro)",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/test-utils",
    "!**/*.test.*",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "design-system",
    "ui",
    "components",
    "theme",
    "styled-components",
    "ellobo"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AndCordeiro/ellobo_design_system.git"
  },
  "homepage": "https://github.com/AndCordeiro/ellobo_design_system#readme",
  "bugs": {
    "url": "https://github.com/AndCordeiro/ellobo_design_system/issues"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "build": "npm run clean && npm run sync-version && bob build",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "sync-version": "node scripts/sync-version.mjs",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "example:install": "npm install --prefix example",
    "example:start": "npm run start --prefix example",
    "example:android": "npm run android --prefix example",
    "example:ios": "npm run ios --prefix example",
    "example:typecheck": "npm run typecheck --prefix example",
    "changeset": "changeset",
    "version": "changeset version && npm run sync-version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-svg": ">=15.0.0",
    "styled-components": ">=6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-test-renderer": "19.2.3",
    "styled-components": "^6.5.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "{**/{__tests__,__fixtures__,__mocks__,test-utils}/**,**/*.test.*}",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
